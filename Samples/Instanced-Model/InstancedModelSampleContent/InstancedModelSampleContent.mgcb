
#----------------------------- Global Properties ----------------------------#

/outputDir:bin/$(Platform)
/intermediateDir:obj/$(Platform)
/config:
/profile:Reach
/compress:True
/compression:Brotli

#-------------------------------- References --------------------------------#

/reference:..\InstancedModelPipeline\bin\Debug\netstandard2.0\InstancedModelPipeline.dll

#---------------------------------- Content ---------------------------------#

#begin Cats.fbx
/importer:FbxImporter
/processor:InstancedModelProcessor
/build:Cats.fbx

#begin Font.spritefont
/importer:FontDescriptionImporter
/processor:FontDescriptionProcessor
/processorParam:PremultiplyAlpha=True
/processorParam:TextureFormat=Compressed
/processorParam:Smoothing=Normal
/build:Font.spritefont

#begin InstancedModel.fx
/importer:EffectImporter
/processor:EffectProcessor
/processorParam:DebugMode=Auto
/build:InstancedModel.fx

